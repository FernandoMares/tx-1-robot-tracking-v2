# Fuente de datos. "mock" es el valor seguro y predeterminado para desarrollo local.
NEXT_PUBLIC_PLANT_DATA_MODE=mock

# URL base del servicio de tracking. En modo live se consulta desde el navegador.
# Dentro del RDP, usa localhost si la API corre en esa misma maquina.
NEXT_PUBLIC_TRACKING_API_URL=http://localhost:8085

# Intervalos expresados en milisegundos.
NEXT_PUBLIC_TRACKING_POLL_MS=1000
NEXT_PUBLIC_TRACKING_STALE_MS=3500
NEXT_PUBLIC_TRACKING_TIMEOUT_MS=4000

# No agregues tokens, contrasenas ni otros secretos a variables NEXT_PUBLIC_*.
